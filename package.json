{
  "name": "casa-velado",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Casa Velado: a fictional cigar house, built as a design portfolio project.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "node scripts/validate-content.mjs && astro check && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "verify:dist": "node scripts/check-dist.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
