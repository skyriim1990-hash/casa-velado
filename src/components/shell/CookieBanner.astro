---
// The cookie notice (blueprint 5.4): small, bottom left, with no layer over the page, and two
// equal buttons, “Accept” and “Necessary only”. It stores the choice and nothing else: the
// site sets no cookies and loads no analytics, so neither button changes what runs.
// It appears only once the age check is answered, and only when no choice is stored (the
// inline script in <head> marks <html class="cookies-pending">). It needs JavaScript; without
// it, nothing is stored and nothing is asked.
import Button from '../Button.astro';
import { microcopy, nav } from '../../data/site.ts';

const c = microcopy.cookies;
const label = nav.legal.find((item) => item.href === '/cookies')?.label ?? 'Cookies';
---

<section class="cookies" aria-label={label} data-cookies>
  <p>{c.text}</p>
  <div class="actions">
    <Button variant="secondary" data-cookie="all">
      {c.accept}
    </Button>
    <Button variant="secondary" data-cookie="necessary">
      {c.necessaryOnly}
    </Button>
  </div>
</section>

<style>
  .cookies {
    position: fixed;
    inset-block-end: var(--space-16);
    inset-inline-start: var(--margin);
    z-index: var(--z-header);
    box-sizing: border-box;
    display: none;
    gap: var(--space-16);
    inline-size: min(calc(100% - 2 * var(--margin)), 24rem);
    padding: var(--space-16) var(--space-16) var(--space-24);
    background: var(--surface);
    border: var(--line) solid var(--border);
  }

  :global(html.cookies-pending:not(.age-pending)) .cookies {
    display: grid;
  }

  p {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-2);
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  /* Equal status: both buttons are the same size and the same kind. */
  .actions :global(.btn) {
    inline-size: 100%;
    padding-inline: var(--space-8);
  }
</style>
