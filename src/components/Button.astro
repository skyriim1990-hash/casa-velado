---
// Buttons (blueprint 5.4). Primary is ivory on the page colour, never gold. Secondary is an
// outline. “text” is a button that looks like a text link. An element with `href` is a link;
// otherwise a button. Hover applies to fine pointers only. Disabled is 40% and `not-allowed`.
//
// `data-demo-state="hover|active"` forces a state for the specimens on /styleguide. It is the
// same rule as the real state, in the same place, so a specimen can never drift from the
// product; nothing on the site sets it.
interface Props {
  variant?: 'primary' | 'secondary' | 'text';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  [attr: `data-${string}`]: string | boolean | undefined;
  [attr: `aria-${string}`]: string | boolean | undefined;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;
---

{href ? (
  <a class:list={['btn', `btn--${variant}`, className]} href={href} {...rest}>
    <slot />
  </a>
) : (
  <button
    class:list={['btn', `btn--${variant}`, className]}
    type={type}
    disabled={disabled}
    {...rest}
  >
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--fs-button);
    font-weight: var(--fw-medium);
    line-height: var(--lh-button);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    border-radius: 0;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* 48px high, 28px of padding either side. */
  .btn--primary,
  .btn--secondary {
    box-sizing: border-box;
    min-block-size: var(--target);
    padding-inline: 1.75rem;
    border: var(--line) solid transparent;
  }

  .btn--primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }

  /* The text button looks like a text link (blueprint 5.4): a 1px underline at 40%. */
  .btn--text {
    min-block-size: var(--target);
    padding-inline: var(--space-8);
    background: none;
    color: inherit;
    font-weight: var(--fw-regular);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .btn:active:not(:disabled),
  .btn[data-demo-state='active'] {
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover:not(:disabled),
    .btn--primary[data-demo-state='hover'] {
      background: var(--text-hover);
    }

    .btn--secondary:hover:not(:disabled),
    .btn--secondary[data-demo-state='hover'] {
      border-color: var(--text);
    }

    .btn--text:hover:not(:disabled),
    .btn--text[data-demo-state='hover'] {
      text-decoration-color: currentColor;
    }
  }

  /* On a phone the main action takes the full width. */
  @media (max-width: 639px) {
    .btn--primary {
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
