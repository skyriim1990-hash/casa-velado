---
// The article card (blueprint 4.7, 5.4, 8): the cover (4:5 for the large card, 3:2 for the
// small), a line of capitals with the category and the date, the title in Garamond H3 and, on
// the large card, the excerpt. The whole card is one link to the entry.
//
// Hover (fine pointers only): the cover scales to 1.03 over 800ms. It is the only photograph on
// the site that moves. Under reduced motion it does not.
//
// The cover's alt is empty: the title in the same link names the entry. The excerpt is shown
// only when the entry has one; entries not yet written have none and show nothing in its place.
// `data-demo-state="hover"` forces hover for /styleguide only.
import Label from './Label.astro';
import Photo from './Photo.astro';
import { formatDate } from '../lib/format.ts';
import type { Article, Ratio } from '../lib/schemas.ts';

interface Props {
  /** The entry's slug, for the link. */
  id: string;
  article: Article;
  variant?: 'large' | 'small';
  /** The picture's ratio, where a page wants another than the variant's own (large 4:5, small 3:2). */
  ratio?: Ratio;
  /** Overrides the entry's excerpt. Only for a specimen. */
  excerpt?: string;
  headingLevel?: 2 | 3 | 4;
  class?: string;
  [attr: `data-${string}`]: string | boolean | undefined;
}

const {
  id,
  article,
  variant = 'small',
  ratio: ratioProp,
  excerpt,
  headingLevel = 3,
  class: className,
  ...rest
} = Astro.props;

const Heading = `h${headingLevel}` as 'h3';
const ratio = ratioProp ?? (variant === 'large' ? '4:5' : '3:2');
const text = variant === 'large' ? (excerpt ?? article.excerpt) : null;
---

<a class:list={['card', `card--${variant}`, className]} href={`/journal/${id}`} {...rest}>
  <div class="media">
    <Photo
      image={article.cover}
      {ratio}
      alt=""
      kind="articleCover"
      sizes={
        variant === 'large'
          ? '(min-width: 1024px) 58vw, 100vw'
          : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
      }
    />
  </div>
  <div class="text">
    <Label as="p">
      {article.category} · {formatDate(article.date)}
    </Label>
    <Heading class="title">{article.title}</Heading>
    {text && <p class="excerpt">{text}</p>}
  </div>
</a>

<style>
  .card {
    display: grid;
    gap: var(--space-16);
    align-content: start;
    color: inherit;
    text-decoration: none;
  }

  /* The wrapper clips the scaled photograph, so nothing outside the card moves. */
  .media {
    display: block;
    overflow: hidden;
  }

  .media :global(.photo) {
    transition: transform var(--dur-zoom) var(--ease-out);
  }

  .text {
    display: grid;
    gap: var(--space-8);
    justify-items: start;
  }

  .title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    text-wrap: balance;
  }

  .excerpt {
    max-inline-size: var(--measure);
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--text-2);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card:hover .media :global(.photo),
    .card[data-demo-state='hover'] .media :global(.photo) {
      transform: scale(1.03);
    }
  }
</style>
