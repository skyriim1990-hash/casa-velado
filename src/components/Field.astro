---
// A form field (blueprint 5.4): text, email, tel, search or a select. The label sits above and
// is never replaced by a placeholder. The control is 48px high, square, with a 1px border;
// the focus border turns to --text, and the focus ring comes from base.css.
//
// Wiring, so a script only has to fill in text:
//   label[for] ↔ control[id]
//   aria-describedby → the hint (if any) and the error paragraph
//   aria-invalid="true" while there is an error (the `error` prop, or set by a script)
//   the error paragraph carries [data-field-error]
//
// Required is the default, as in the blueprint's forms; an optional field says so in its label
// (`optional`: “Note (optional)”). The native `required` attribute is set for required fields.
//
// `demoState` forces hover or focus for the specimens on /styleguide only (data-field-state).
import { microcopy } from '../data/site.ts';

interface Props {
  id: string;
  name: string;
  label: string;
  /** A text-like input, a date or a time, a textarea, or a select (then give `options`). */
  type?: 'text' | 'email' | 'tel' | 'search' | 'date' | 'time' | 'textarea' | 'select';
  /** For a textarea: its height in lines. */
  rows?: number;
  options?: { value: string; label: string }[];
  value?: string;
  placeholder?: string;
  autocomplete?: string;
  /** Required by default. */
  required?: boolean;
  /** Adds “(optional)” to the label. */
  optional?: boolean;
  hint?: string;
  error?: string;
  disabled?: boolean;
  demoState?: 'hover' | 'focus';
  class?: string;
  [attr: `data-${string}`]: string | boolean | undefined;
}

const {
  id,
  name,
  label,
  type = 'text',
  options = [],
  rows = 5,
  value,
  placeholder,
  autocomplete,
  required = true,
  optional = false,
  hint,
  error,
  disabled = false,
  demoState,
  class: className,
  ...rest
} = Astro.props;

const isSelect = type === 'select';
const isTextarea = type === 'textarea';
const isRequired = required && !optional;
const describedBy = [hint ? `${id}-hint` : '', `${id}-error`].filter(Boolean).join(' ');
---

<div
  class:list={['field', className]}
  data-disabled={disabled ? '' : undefined}
  data-field-state={demoState}
>
  <label for={id}>
    {label}
    {optional && ` ${microcopy.forms.optional}`}
  </label>
  {hint && (
    <p class="hint" id={`${id}-hint`}>
      {hint}
    </p>
  )}
  {isSelect ? (
    <div class="select">
      <select
        {id}
        {name}
        {autocomplete}
        required={isRequired}
        {disabled}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        {...rest}
      >
        {placeholder !== undefined && (
          <option value="" selected={!value}>
            {placeholder}
          </option>
        )}
        {options.map((o) => (
          <option value={o.value} selected={o.value === value}>
            {o.label}
          </option>
        ))}
      </select>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </div>
  ) : isTextarea ? (
    <textarea
      {id}
      {name}
      {rows}
      {placeholder}
      {autocomplete}
      required={isRequired}
      {disabled}
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
      {...rest}
    >{value}</textarea>
  ) : (
    <input
      {id}
      {name}
      {type}
      {value}
      {placeholder}
      {autocomplete}
      required={isRequired}
      {disabled}
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
      {...rest}
    />
  )}
  <p class="error" id={`${id}-error`} data-field-error>
    {error}
  </p>
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-8);
  }

  label {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-2);
  }

  .hint {
    margin-block-start: calc(-1 * var(--space-4));
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  input,
  select,
  textarea {
    box-sizing: border-box;
    inline-size: 100%;
    block-size: var(--target);
    padding-inline: var(--space-16);
    background: var(--surface);
    border: var(--line) solid var(--border);
    border-radius: 0;
    font-size: var(--fs-ui);
    appearance: none;
  }

  /* A note or a message: as wide as the field, as tall as its lines, and it can be pulled taller. */
  textarea {
    padding-block: var(--space-12);
    line-height: var(--lh-ui);
    block-size: auto;
    min-block-size: 8rem;
    resize: vertical;
    font-family: inherit;
    color: inherit;
  }

  input::placeholder {
    color: var(--text-3);
    opacity: 1;
  }

  /* A select: the arrow is a 1.5px line inline SVG at the right edge. */
  .select {
    position: relative;
    display: grid;
  }

  select {
    padding-inline-end: var(--space-48);
    cursor: pointer;
  }

  .select svg {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: var(--space-16);
    translate: 0 -50%;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover:not(:disabled),
    select:hover:not(:disabled),
    textarea:hover:not(:disabled),
    [data-field-state='hover'] input,
    [data-field-state='hover'] select {
      border-color: var(--text-2);
    }
  }

  input:focus,
  select:focus,
  textarea:focus,
  [data-field-state='focus'] input,
  [data-field-state='focus'] select {
    border-color: var(--text);
  }

  [data-field-state='focus'] input,
  [data-field-state='focus'] select {
    outline: var(--focus-width) solid var(--text);
    outline-offset: var(--focus-offset);
  }

  /* An error is told by its border, by the message beneath, and by aria-invalid. */
  [aria-invalid='true'] {
    border-color: var(--error);
  }

  .error {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--error);
  }

  .error:empty {
    display: none;
  }

  .field[data-disabled] {
    opacity: 0.4;
  }

  .field[data-disabled] input,
  .field[data-disabled] select,
  .field[data-disabled] label {
    cursor: not-allowed;
  }
</style>
