---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
// /styleguide: the Gate A review page (blueprint 2.1, 10.3). Not linked from the site,
// `noindex`, absent from the sitemap. Stage 2 covers colour, type, space, lines, focus
// and motion. Brand assets (Stage 3) and components (Stage 6) are added to this page.
import tokensCss from '../styles/tokens.css?raw';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Label from '../components/Label.astro';
import BrandMark from '../components/BrandMark.astro';
import Section from '../components/styleguide/Section.astro';
import Components from '../components/styleguide/Components.astro';
import { contrast, formatRatio, grade, readHexTokens, readTokenValues } from '../lib/contrast';

const hex = readHexTokens(tokensCss);
const motion = readTokenValues(tokensCss, 'dur-');
const easing = readTokenValues(tokensCss, 'ease-');

const swatchGroups = [
  {
    title: 'Dark: the base',
    surface: 'dark',
    items: [
      ['bg', 'Page background. Warm black, never pure black.'],
      ['surface', 'Drawers and blocks.'],
      ['surface-2', 'Product photo ground and photo placeholders.'],
      ['text', 'Body text, ivory.'],
      ['text-2', 'Secondary text.'],
      ['text-3', 'Labels and notes. Not on --surface-2.'],
      ['rule', 'Book-line rules. They carry no information.'],
      ['border', 'Field and button outlines.'],
    ],
  },
  {
    title: 'Paper: reading, ledger, Cosecha',
    surface: 'dark',
    items: [
      ['paper', 'Background of light sections.'],
      ['ink', 'Text on paper.'],
      ['ink-2', 'Secondary text, labels and outlines on paper.'],
      ['paper-rule', 'Book-line rules on paper.'],
    ],
  },
  {
    title: 'Accent and states',
    surface: 'dark',
    items: [
      ['gold', 'On dark only. A trace: active nav line, monogram, small marks.'],
      ['gold-ink', 'Gold on paper.'],
      ['text-hover', 'Primary button hover.'],
      ['error', 'Always with text, never colour alone.'],
      ['success', 'Always with text, never colour alone.'],
    ],
  },
] as const;

// [foreground, background, ratio stated in the blueprint (5.1), where it is used]
const pairs: [string, string, number | null, string][] = [
  ['text', 'bg', 15.1, 'Body text'],
  ['text-2', 'bg', 8.6, 'Secondary text'],
  ['text-3', 'bg', 4.9, 'Labels, notes'],
  ['text-3', 'surface', 4.6, 'Labels on drawers and blocks'],
  ['text-3', 'surface-2', 4.0, 'Not allowed: product photo ground'],
  ['text-2', 'surface-2', null, 'Photo placeholder text'],
  ['border', 'bg', 3.3, 'Field and button outlines (WCAG 1.4.11)'],
  ['gold', 'bg', 6.1, 'Small marks only, not long text'],
  ['error', 'bg', 6.0, 'Error text'],
  ['success', 'bg', 7.3, 'Confirmation text'],
  ['bg', 'text', null, 'Primary button label'],
  ['bg', 'text-hover', null, 'Primary button label, hover'],
  ['ink', 'paper', 13.4, 'Text on paper'],
  ['ink-2', 'paper', 5.7, 'Labels and outlines on paper'],
  ['gold-ink', 'paper', 4.8, 'Gold on paper'],
];

const rows = pairs.map(([fg, bg, stated, use]) => {
  const ratio = contrast(hex[fg] ?? '#000000', hex[bg] ?? '#ffffff');
  return {
    fg,
    bg,
    use,
    ratio: formatRatio(ratio),
    grade: grade(ratio),
    stated: stated === null ? '—' : formatRatio(stated),
    agrees: stated === null ? null : Math.abs(ratio - stated) < 0.06,
  };
});

const spaces = [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 160];

const roles = [
  {
    key: 'display',
    name: 'Display',
    range: '44 → 96 px',
    face: 'Casa Serif',
    weight: '400',
    lh: '1.02',
    note: 'Once on the site: the home hero.',
  },
  {
    key: 'h1',
    name: 'H1',
    range: '36 → 64 px',
    face: 'Casa Serif',
    weight: '400',
    lh: '1.08',
    note: '',
  },
  {
    key: 'h2',
    name: 'H2',
    range: '30 → 48 px',
    face: 'Casa Serif',
    weight: '400',
    lh: '1.12',
    note: '',
  },
  {
    key: 'h3',
    name: 'H3',
    range: '22 → 30 px',
    face: 'Casa Serif',
    weight: '500',
    lh: '1.2',
    note: '',
  },
  {
    key: 'h4',
    name: 'H4',
    range: '19 → 22 px',
    face: 'Casa Serif',
    weight: '500',
    lh: '1.3',
    note: '',
  },
  {
    key: 'lead',
    name: 'Lead',
    range: '20 → 24 px',
    face: 'Casa Serif',
    weight: '400',
    lh: '1.45',
    note: '',
  },
  {
    key: 'article',
    name: 'Article text',
    range: '19 → 21 px',
    face: 'Casa Serif',
    weight: '400',
    lh: '1.6',
    note: 'Garamond has a small x-height.',
  },
  {
    key: 'ui',
    name: 'Interface text',
    range: '16 → 17 px',
    face: 'Casa Sans',
    weight: '400',
    lh: '1.55',
    note: '',
  },
  {
    key: 'small',
    name: 'Small text',
    range: '14 px',
    face: 'Casa Sans',
    weight: '400',
    lh: '1.45',
    note: '',
  },
  {
    key: 'label',
    name: 'Label',
    range: '12 px',
    face: 'Casa Sans',
    weight: '500',
    lh: '1.3',
    note: 'Capitals, 0.1em tracking.',
  },
  {
    key: 'button',
    name: 'Button',
    range: '15 px',
    face: 'Casa Sans',
    weight: '500',
    lh: '1',
    note: 'Sentence case.',
  },
] as const;

const ledger = [
  ['Jalapa', 'Petit Corona', '4½ × 42 (114 mm)', '~30 min', '€8.00'],
  ['Galera', 'Robusto', '5 × 50 (127 mm)', '~55 min', '€11.00'],
  ['Galera', 'Churchill', '7 × 48 (178 mm)', '~90 min', '€14.00'],
  ['La Vela', 'Toro', '6 × 52 (152 mm)', '~75 min', '€19.00'],
  ['Cosecha 2020', 'Toro', '6 × 50 (152 mm)', '~75 min', '€32.00'],
];

const breakpoints = [
  ['mobile', 'Mobile', '< 640 px', '4', '16 px', '20 px', 'One column. Thumb at the bottom.'],
  ['tablet', 'Tablet', '640–1023 px', '8', '24 px', '32 px', 'Two columns. No hover.'],
  ['laptop', 'Laptop', '1024–1279 px', '12', '24 px', '48 px', 'Full navigation, sticky elements.'],
  ['desktop', 'Desktop', '1280–1599 px', '12', '32 px', '64 px', 'Full grid, more air.'],
  [
    'wide',
    'Wide',
    '≥ 1600 px',
    '12',
    '32 px',
    'auto',
    'Content stops at 1440 px; photographs continue.',
  ],
] as const;

const containers = [
  ['--w-text', '680 px', 'Article and legal text'],
  ['--w-content', '1200 px', 'Content pages'],
  ['--w-wide', '1440 px', 'Widest content; full-bleed photographs go beyond it'],
] as const;

const durationUse: Record<string, string> = {
  'dur-fast': 'Link underline, button background',
  'dur-base': 'Menu panel, drawer',
  'dur-slow': 'Hero text, scroll reveal',
  'dur-image': 'Image fade-in, card hover, gallery, R3 preview, page transition',
  'dur-story': 'R4 sticky narrative',
  'dur-zoom': 'Article card image: the only image scale on the site',
  'dur-reduced': 'Every overlay under prefers-reduced-motion',
};

// Brand review data. Everything numeric comes from src/brand/measurements.json, which
// scripts/brand/build-brand.mjs writes while it draws the files.
import measure from '../brand/measurements.json';

const wm = measure.wordmark;
const st = measure.stacked;
const mo = measure.monogram;
const mb = measure.bands;
const fv = measure.favicon;
const ti = measure.touchIcon;

const dims = (v: readonly number[]) => ({ w: v[0] ?? 0, h: v[1] ?? 0 });
const wmVB = dims(wm.viewBox);
const stVB = dims(st.viewBox);
const moVB = dims(mo.viewBox);
const fvVB = dims(fv.viewBox);
const tiVB = dims(ti.viewBox);

const pct = (n: number) => `${Math.round(n * 100)}%`;
const pct1 = (n: number) => `${(n * 100).toFixed(1)}%`;
const signed = (n: number, withSign = true) =>
  `${withSign ? (n > 0 ? '+' : n < 0 ? '−' : '') : ''}${Math.abs(n).toFixed(1)}`;
const avgGap = wm.pairs.reduce((sum, p) => sum + p.final, 0) / wm.pairs.length;
const monoShift = (mo.letters.top + mo.letters.base) / 2 - mo.cy;

const ovalSize = (o: readonly number[] | undefined) =>
  `${(o?.[0] ?? 0) * 2} × ${(o?.[1] ?? 0) * 2}`;
const ovalWidth = (key: 'band-1987' | 'band-mid' | 'band-current') =>
  (mb[key].ovals[0]?.[0] ?? 0) * 2;
const lines = (n: number) => (n === 1 ? '1 line' : `${n} lines`);
const describe = (key: 'band-1987' | 'band-mid' | 'band-current') => {
  const b = mb[key];
  return {
    frame: `${lines(b.frames.length)}, ${b.frames.map((f) => f[1]).join(' and ')} thick`,
    oval: `${lines(b.ovals.length)}, outer ${ovalSize(b.ovals[0])}, ${b.ovals.map((o) => o[2]).join(' and ')} thick`,
    letters: `weight ${b.letters.wght}, tracking ${b.letters.tracking}em, ink ${b.letters.width} wide`,
  };
};
const bandRows = [
  {
    mark: 'band-1987' as const,
    step: 'Historical variant 1 of 3',
    title: '1987: the first ring',
    text: 'One rule round the strip, one line round the oval, open letters.',
    alt: 'Band from 1987: a single frame, a single-line oval and open letters',
    ...describe('band-1987'),
  },
  {
    mark: 'band-mid' as const,
    step: 'Historical variant 2 of 3',
    title: '[YEAR]: the middle ring',
    text: 'The year is for the owner to supply. The double line appears on the oval.',
    alt: 'Band from the middle period: a single frame and a double-line oval',
    ...describe('band-mid'),
  },
  {
    mark: 'band-current' as const,
    step: 'Current ring',
    title: 'Today',
    text: 'A double frame and a double-line oval: the seal of the monogram.',
    alt: 'Current band: a double frame and a double-line oval',
    ...describe('band-current'),
  },
];

const minWidths = [240, 200, 160, 120] as const;

// The ICO's three embedded PNGs, read from the shipped file and shown as data URIs
// (nothing extra is written to dist/).
const ico = readFileSync(join(process.cwd(), 'public/favicon.ico'));
const icoEntries = Array.from({ length: ico.readUInt16LE(4) }, (_, i) => {
  const at = 6 + i * 16;
  const bytes = ico.readUInt32LE(at + 8);
  const offset = ico.readUInt32LE(at + 12);
  return {
    size: ico.readUInt8(at) || 256,
    bytes,
    uri: `data:image/png;base64,${ico.subarray(offset, offset + bytes).toString('base64')}`,
  };
});
---

<Base
  title="Styleguide"
  description="Colour, type, space, lines, focus and motion for Casa Velado. An internal review page for a portfolio project."
  noindex
>
  <header class="intro" data-surface="dark">
    <Container>
      <Label>Casa Velado · Styleguide · Gate A review</Label>
      <h1>Styleguide</h1>
      <p class="lead-in">
        The rules the pages are built from. This version covers colour, type, brand marks, space,
        lines, focus, motion and the core components. The page is not linked from the site and is
        kept out of search.
      </p>
      <dl class="viewport">
        <div>
          <dt>Viewport</dt>
          <dd>
            <output data-viewport>—</output>
          </dd>
        </div>
        <div>
          <dt>Breakpoint</dt>
          <dd>
            <output data-breakpoint>—</output>
          </dd>
        </div>
      </dl>
      <nav aria-label="Styleguide sections">
        <ul class="toc">
          <li>
            <a href="#principles">Principles</a>
          </li>
          <li>
            <a href="#colour">Colour</a>
          </li>
          <li>
            <a href="#type">Type</a>
          </li>
          <li>
            <a href="#brand">Brand</a>
          </li>
          <li>
            <a href="#space">Space</a>
          </li>
          <li>
            <a href="#lines">Lines and surfaces</a>
          </li>
          <li>
            <a href="#focus">Focus</a>
          </li>
          <li>
            <a href="#motion">Motion</a>
          </li>
          <li>
            <a href="#buttons">Buttons</a>
          </li>
          <li>
            <a href="#links">Links</a>
          </li>
          <li>
            <a href="#fields">Fields</a>
          </li>
          <li>
            <a href="#badges">Badges</a>
          </li>
          <li>
            <a href="#strength">Strength</a>
          </li>
          <li>
            <a href="#bookline">Book line</a>
          </li>
          <li>
            <a href="#product-card">Product card</a>
          </li>
          <li>
            <a href="#article-card">Article card</a>
          </li>
          <li>
            <a href="#photo">Photo and crops</a>
          </li>
        </ul>
      </nav>
    </Container>
  </header>

  <!-- Principles -->
  <Section id="principles" label="01 · Principles" title="A small house that keeps a book">
    <div class="principles">
      <blockquote class="north-star">
        <p class="lead">
          Dark like the curing room at night. Light like a page from the harvest ledger. It speaks
          through places, numbers, months, materials and process, never through inflated adjectives.
        </p>
        <p>
          <i>Quiet confidence over visual excess.</i>
        </p>
      </blockquote>
      <ul class="rules">
        <li>Corners are square. The one exception is the 2 px checkbox.</li>
        <li>No shadows, no glass, no decorative gradients.</li>
        <li>Gold is a trace: at most one gold element on a screen, never a fill or a glow.</li>
        <li>Headings are weight 400. Capitals with tracking belong to labels only.</li>
        <li>The display size is used once on the site.</li>
        <li>The book line appears only where there is real data to set in rows.</li>
        <li>Motion explains a change. Only opacity and transform move.</li>
      </ul>
    </div>
  </Section>

  <!-- Colour -->
  <Section id="colour" label="02 · Colour" title="Warm dark, paper, one trace of gold">
    {swatchGroups.map((group) => (
      <div class="group">
        <h3>{group.title}</h3>
        <ul class="swatches">
          {group.items.map(([name, role]) => (
            <li class="swatch">
              <span class="chip" style={`background: var(--${name})`} aria-hidden="true" />
              <code>--{name}</code>
              <span class="hex">{hex[name]?.toUpperCase()}</span>
              <span class="role">{role}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="group">
      <h3>Contrast</h3>
      <p class="note">
        Computed from the tokens when the site is built, not typed in. “Stated” is the ratio in the
        blueprint; a difference is marked “(differs)”.
      </p>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Text on background</th>
            <th scope="col" class="num">
              Ratio
            </th>
            <th scope="col" class="num">
              Stated
            </th>
            <th scope="col">Grade</th>
            <th scope="col">Use</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td data-label="Pair">
                <span>
                  <code>--{row.fg}</code> on <code>--{row.bg}</code>
                </span>
              </td>
              <td data-label="Ratio" class="num">
                {row.ratio}
              </td>
              <td data-label="Stated" class="num">
                {row.stated}
                {row.agrees === false && ' (differs)'}
              </td>
              <td data-label="Grade">{row.grade}</td>
              <td data-label="Use">{row.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="group">
      <h3>Surface scope</h3>
      <p class="note">
        One attribute remaps the same token names. A component written with <code>--text</code> on
        <code>--bg</code> is correct on both.
      </p>
      <div class="scopes">
        <div class="scope" data-surface="dark">
          <Label>data-surface="dark"</Label>
          <p class="scope-title">Galera Robusto</p>
          <p>Medium-bodied, even, about an hour.</p>
        </div>
        <div class="scope" data-surface="paper">
          <Label>data-surface="paper"</Label>
          <p class="scope-title">Galera Robusto</p>
          <p>Medium-bodied, even, about an hour.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Type -->
  <Section id="type" label="03 · Type" title="Garamond for the book, Plex for the data">
    <div class="group">
      <h3>Families</h3>
      <div class="families">
        <div class="family family--serif">
          <Label>Serif · headings, lead, articles</Label>
          <p class="family-name">Casa Serif</p>
          <p class="family-meta">EB Garamond, variable 400–600, with italic.</p>
          <p class="glyphs">Aa Bb Cc Dd Ee Ff Gg 0123456789 Í ó ñ “ ” ‘ ’ – × € ½ 5⅝</p>
        </div>
        <div class="family family--sans">
          <Label>Sans · interface, data, labels</Label>
          <p class="family-name">Casa Sans</p>
          <p class="family-meta">IBM Plex Sans, 400 and 500. Tabular figures by default.</p>
          <p class="glyphs">Aa Bb Cc Dd Ee Ff Gg 0123456789 Í ó ñ “ ” ‘ ’ – × € ½ 5⅝ → ✓</p>
        </div>
      </div>
      <p class="note">
        Both are self-hosted WOFF2, subset to Basic Latin, Latin-1 and Latin Extended-A. Fallbacks
        are metric-matched, so the swap does not move the layout. Garamond has no ✓ glyph; the check
        mark is set in Plex or drawn as an SVG.
      </p>
    </div>

    <div class="group">
      <h3>Scale</h3>
      <p class="note">
        Sizes are fluid between 360 px and 1600 px, then stop growing. “Now” is the size at this
        viewport.
      </p>
      <ul class="scale">
        {roles.map((role) => (
          <li class="role-row">
            <div class="role-meta">
              <span class="role-name">{role.name}</span>
              <span class="role-spec">
                {role.face} {role.weight} · {role.range} · line {role.lh}
              </span>
              <span class="role-spec">
                Now <output data-live={role.key}>—</output>
                {role.note && ` · ${role.note}`}
              </span>
            </div>
            <div class="role-sample" data-role={role.key}>
              {role.key === 'display' && 'Tobacco, left to mature.'}
              {role.key === 'h1' && 'Galera Robusto'}
              {role.key === 'h2' && 'Four lines and one harvest a year.'}
              {role.key === 'h3' && 'Robusto'}
              {role.key === 'h4' && 'Second third'}
              {role.key === 'lead' && (
                <>
                  <i lang="es">Velar</i> means to keep watch. During the curing season, someone
                  stays in the <i lang="es">galera</i> through the night, opening and closing the
                  doors as the air changes.
                </>
              )}
              {role.key === 'article' &&
                'The first cigars to carry our name were rolled for the family and for a few merchants who knew us. The orders grew; we stayed few. We decided not to grow faster than the tobacco allows.'}
              {role.key === 'ui' &&
                'Four permanent lines and one edition a year. Every cigar is rolled by hand in Estelí.'}
              {role.key === 'small' &&
                'Delivered within [TIMEFRAME] to [SHIPPING REGIONS]. Adults only.'}
              {role.key === 'label' && 'Estelí, Nicaragua · Est. 1987'}
              {role.key === 'button' && 'Add to cart · €11.00'}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="group">
      <h3>Figures</h3>
      <p class="note">
        Prices, sizes and times use tabular figures, so columns align. Currency is
        <code>€11.00</code>, sizes <code>5 × 50 (127 mm)</code>, times <code>~55 min</code>.
      </p>
      <table class="table table--ledger">
        <thead>
          <tr>
            <th scope="col">Line</th>
            <th scope="col">Vitola</th>
            <th scope="col">Size</th>
            <th scope="col">Time</th>
            <th scope="col" class="num">
              From
            </th>
          </tr>
        </thead>
        <tbody>
          {ledger.map(([line, vitola, size, time, price]) => (
            <tr>
              <td data-label="Line">{line}</td>
              <td data-label="Vitola">{vitola}</td>
              <td data-label="Size" class="num-left">
                {size}
              </td>
              <td data-label="Time" class="num-left">
                {time}
              </td>
              <td data-label="From" class="num">
                {price}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="group">
      <h3>Rules</h3>
      <ul class="rules">
        <li>Headings are 400. H3 and H4 are 500. Never 700.</li>
        <li>
          Italic is for one word, a subtitle, a signature or a Spanish craft term, marked
          <code>&lt;i lang="es"&gt;</code>, as in <i lang="es">galera</i>, <i lang="es">pilón</i>,
          <i lang="es">capa</i>, <i lang="es">entubado</i>.
        </li>
        <li>Sentence case everywhere. Capitals with tracking are for labels only.</li>
        <li>Lines of text run 60–72 characters.</li>
        <li>
          Typographic marks: “double” and ‘single’ quotes, an en dash in ranges (45–60 days), × in
          sizes.
        </li>
        <li>
          Headings balance and body text wraps with <code>text-wrap: pretty</code>. Headings are not
          hyphenated.
        </li>
      </ul>
    </div>

    <div class="group" data-surface="paper">
      <div class="paper-block">
        <Label>On paper</Label>
        <p class="paper-article">
          Article text sits on paper in ink. The measure is about 680 px, and Garamond is set a
          little larger than the interface text because its x-height is small. A reading page is the
          one place the book is allowed to be quiet for a long time.
        </p>
      </div>
    </div>
  </Section>

  <!-- Brand review -->
  <Section id="brand" label="04 · Brand review" title="Brand review: for designer approval">
    <div class="group">
      <p class="note">
        Every mark below is the shipped file, unchanged. The grey guides are drawn over the same
        files for inspection only and are not part of any asset. The measurements come from the
        generator that drew the files, not from typed-in values. Units are viewBox units unless a
        size is given in px.
      </p>
      <ul class="review-index">
        <li>
          <a href="#rv-wordmark">1 Wordmark</a>
        </li>
        <li>
          <a href="#rv-stacked">2 Stacked wordmark</a>
        </li>
        <li>
          <a href="#rv-monogram">3 Monogram</a>
        </li>
        <li>
          <a href="#rv-bands">4–6 Bands</a>
        </li>
        <li>
          <a href="#rv-min">Minimum size</a>
        </li>
        <li>
          <a href="#rv-favicon">7–9 Favicon, ICO, touch icon</a>
        </li>
      </ul>
    </div>

    <!-- 1 Wordmark -->
    <div class="group review" id="rv-wordmark">
      <h3>1 · Wordmark</h3>
      <p class="file">
        logo-wordmark.svg · viewBox {wmVB.w} × {wmVB.h}
      </p>
      <div class="brand-pair">
        <div class="brand-stage" data-surface="dark">
          <Label>On dark</Label>
          <BrandMark mark="wordmark" label="Casa Velado, established 1987, Estelí" class="wm" />
        </div>
        <div class="brand-stage" data-surface="paper">
          <Label>On paper</Label>
          <BrandMark mark="wordmark" label="Casa Velado, established 1987, Estelí" class="wm" />
        </div>
      </div>

      <div class="brand-stage brand-stage--guides" data-surface="dark">
        <Label>Same file with guides: cap line, baseline, ink edge of every letter</Label>
        <div class="guided guided--wordmark">
          <BrandMark mark="wordmark" class="wm" />
          <svg
            class="guides"
            viewBox={`0 0 ${wmVB.w} ${wmVB.h}`}
            aria-hidden="true"
            focusable="false"
          >
            <g class="g-line">
              <line
                x1="0"
                x2={wmVB.w}
                y1={wm.nameBase - wm.nameCap}
                y2={wm.nameBase - wm.nameCap}
              />
              <line x1="0" x2={wmVB.w} y1={wm.nameBase} y2={wm.nameBase} />
              <line x1="0" x2={wmVB.w} y1={wm.subBase - wm.subCap} y2={wm.subBase - wm.subCap} />
              <line x1="0" x2={wmVB.w} y1={wm.subBase} y2={wm.subBase} />
            </g>
            {wm.glyphs.map((g, i) => (
              <>
                <line
                  class="g-edge"
                  x1={g.left}
                  x2={g.left}
                  y1={wm.nameBase - wm.nameCap}
                  y2={wm.nameBase}
                />
                <line
                  class="g-edge"
                  x1={g.right}
                  x2={g.right}
                  y1={wm.nameBase - wm.nameCap}
                  y2={wm.nameBase}
                />
                {wm.glyphs[i + 1] && (
                  <rect
                    class="g-gap"
                    x={g.right}
                    y={wm.nameBase - wm.nameCap}
                    width={wm.glyphs[i + 1]!.left - g.right}
                    height={wm.nameCap}
                  />
                )}
              </>
            ))}
          </svg>
        </div>
        <p class="note">
          Shaded bands are the ink gaps between letters. The wide one is the word space.
        </p>
      </div>

      <dl class="rationale">
        <div>
          <dt>Proportions</dt>
          <dd>
            The name is Garamond capitals with a cap height of {wm.nameCap} units in a box of{' '}
            {wmVB.w} × {wmVB.h}, with {wm.pad} units of margin on every side. The sub-line is Plex
            500 with a cap height of {wm.subCap}, which is {pct(wm.subCap / wm.nameCap)} of the
            name's. Its ink is {wm.subInkWidth} wide, {pct(wm.subInkWidth / wm.nameInkWidth)}
            of the name's {wm.nameInkWidth}. It sits {wm.gapNameToSub} below the baseline,{' '}
            {(wm.gapNameToSub / wm.nameCap).toFixed(2)} of the name's cap height, and is aligned
            left under the C, never centred.
          </dd>
        </div>
        <div>
          <dt>Tracking and manual kerning</dt>
          <dd>
            Tracking is {wm.nameTracking}em, {wm.nameTracking * wm.nameSize} units at this size,
            added after every letter. The font's own kerning is zero for all eight letter pairs in
            the name, so the manual corrections are the only optical adjustment between letters.
            They are small beside the tracking, and the biggest are where a diagonal meets a stem:
            VE and LA are drawn in. The generator also lists AV, which has no effect: A and V are
            separated by the word space. The word space is {pct(wm.wordSpace)} of a tracked space,
            which leaves {wm.wordGap} between the A and the V, about
            {(wm.wordGap / avgGap).toFixed(1)} times the average letter gap of {avgGap.toFixed(1)}.
          </dd>
        </div>
      </dl>

      <table class="table">
        <caption class="cap">
          Gap between the ink of two neighbouring letters, in units at name size 100
        </caption>
        <thead>
          <tr>
            <th scope="col">Pair</th>
            <th scope="col" class="num">
              Natural
            </th>
            <th scope="col" class="num">
              Font kerning
            </th>
            <th scope="col" class="num">
              Tracking
            </th>
            <th scope="col" class="num">
              Manual
            </th>
            <th scope="col" class="num">
              Final
            </th>
          </tr>
        </thead>
        <tbody>
          {wm.pairs.map((p) => (
            <tr>
              <td data-label="Pair">{p.pair}</td>
              <td data-label="Natural" class="num">
                {signed(p.natural, false)}
              </td>
              <td data-label="Font kerning" class="num">
                {signed(p.kern)}
              </td>
              <td data-label="Tracking" class="num">
                {signed(p.tracking)}
              </td>
              <td data-label="Manual" class="num">
                {signed(p.manual)}
              </td>
              <td data-label="Final" class="num">
                {signed(p.final, false)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 2 Stacked -->
    <div class="group review" id="rv-stacked">
      <h3>2 · Stacked wordmark</h3>
      <p class="file">
        logo-wordmark-stacked.svg · viewBox {stVB.w} × {stVB.h}
      </p>
      <div class="brand-pair">
        <div class="brand-stage brand-stage--centre" data-surface="dark">
          <Label>On dark</Label>
          <BrandMark
            mark="wordmark-stacked"
            label="Casa Velado, established 1987, Estelí"
            class="wm-stacked"
          />
        </div>
        <div class="brand-stage brand-stage--centre" data-surface="paper">
          <Label>On paper</Label>
          <BrandMark
            mark="wordmark-stacked"
            label="Casa Velado, established 1987, Estelí"
            class="wm-stacked"
          />
        </div>
      </div>
      <dl class="rationale">
        <div>
          <dt>Proportions</dt>
          <dd>
            Both name lines keep the horizontal wordmark's size and tracking, so the letters are
            spaced exactly as before. CASA is {st.casaInk} wide and VELADO {st.veladoInk}, so CASA
            is {pct(st.casaInk / st.veladoInk)} of VELADO. The lines are {st.lineLead} apart,{' '}
            {st.lineLeadRatio} of the cap height. CASA, VELADO and the sub-line all centre on x ={' '}
            {st.casaCentre}. CASA is not stretched to the width of VELADO: that needed a tracking of
            0.75em, and the four letters read as separate marks.
          </dd>
        </div>
      </dl>
    </div>

    <!-- 3 Monogram -->
    <div class="group review" id="rv-monogram">
      <h3>3 · Monogram</h3>
      <p class="file">
        monogram.svg · viewBox {moVB.w} × {moVB.h}
      </p>
      <div class="brand-pair">
        <div class="brand-stage brand-stage--centre brand-stage--gold" data-surface="dark">
          <Label>On dark, gold</Label>
          <BrandMark mark="monogram" label="Casa Velado monogram" class="mono" />
        </div>
        <div class="brand-stage brand-stage--centre" data-surface="paper">
          <Label>On paper, ink</Label>
          <BrandMark mark="monogram" label="Casa Velado monogram" class="mono" />
        </div>
      </div>

      <div class="brand-stage brand-stage--guides brand-stage--centre" data-surface="dark">
        <Label>
          Same file with guides: centre lines, cap line, baseline, ink box of the letters
        </Label>
        <div class="guided guided--mono">
          <BrandMark mark="monogram" class="mono" />
          <svg
            class="guides"
            viewBox={`0 0 ${moVB.w} ${moVB.h}`}
            aria-hidden="true"
            focusable="false"
          >
            <g class="g-line">
              <line x1={mo.cx} x2={mo.cx} y1="0" y2={moVB.h} />
              <line x1="0" x2={moVB.w} y1={mo.cy} y2={mo.cy} />
              <line x1="0" x2={moVB.w} y1={mo.letters.top} y2={mo.letters.top} />
              <line x1="0" x2={moVB.w} y1={mo.letters.base} y2={mo.letters.base} />
            </g>
            <rect
              class="g-box"
              x={mo.letters.left}
              y={mo.letters.top}
              width={mo.letters.width}
              height={mo.letters.base - mo.letters.top}
            />
          </svg>
        </div>
      </div>

      <dl class="rationale">
        <div>
          <dt>Proportions</dt>
          <dd>
            The outer oval is {mo.outer.rx * 2} × {mo.outer.ry * 2}, a ratio of{' '}
            {(mo.outer.rx / mo.outer.ry).toFixed(2)} : 1. The inner oval is {mo.inner.rx * 2} ×{' '}
            {mo.inner.ry * 2}, {mo.outer.rx - mo.inner.rx} units inside it. The outer line is{' '}
            {mo.outer.stroke} and the inner {mo.inner.stroke}, so the outer carries{' '}
            {(mo.outer.stroke / mo.inner.stroke).toFixed(1)} times the weight. The letters are
            Garamond 400 with a cap height of {mo.letters.cap},
            {pct(mo.letters.cap / (mo.outer.ry * 2))} of the oval's height, and an ink width of{' '}
            {mo.letters.width}, {pct(mo.letters.width / (mo.outer.rx * 2))} of its width. They are
            tracked {mo.letters.tracking}em; their ink is centred across the oval and sits{' '}
            {monoShift} unit below its centre, a small optical correction.
          </dd>
        </div>
      </dl>
    </div>

    <!-- 4-6 Bands -->
    <div class="group review" id="rv-bands">
      <h3>4–6 · Bands</h3>
      <p class="note">
        Shown at 640 px, the width of the artwork. The three differ only in the number and weight of
        their lines and in the letters; the strip, the cap height and the centred monogram do not
        change. None carries text or gold.
      </p>
      <ul class="band-rows">
        {bandRows.map((b) => (
          <li class="band-row">
            <div class="band-art">
              <BrandMark mark={b.mark} label={b.alt} />
            </div>
            <div class="band-info">
              <p class="band-title">
                <span class="band-step">{b.step}</span>
                {b.title}
              </p>
              <p class="file">{b.mark}.svg</p>
              <p class="band-text">{b.text}</p>
              <dl class="band-spec">
                <div>
                  <dt>Frame</dt>
                  <dd>{b.frame}</dd>
                </div>
                <div>
                  <dt>Oval</dt>
                  <dd>{b.oval}</dd>
                </div>
                <div>
                  <dt>Letters</dt>
                  <dd>{b.letters}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <dl class="rationale">
        <div>
          <dt>Differences between the three</dt>
          <dd>
            Each step adds one line or thins one. The first ring has one frame and one oval line,
            both
            {mb['band-1987'].frames[0]![1]} thick, with open 500-weight letters. The middle ring
            keeps the single frame, thins it to
            {mb['band-mid'].frames[0]![1]} and adds the second, finer line to the oval. The current
            ring adds a second frame line and thins everything again, which makes the oval the same
            seal as the monogram. As the lines thin, the letters lighten from 500 to 400 and close
            up from {mb['band-1987'].letters.tracking}em to {mb['band-current'].letters.tracking}em,
            and the oval grows a little, from {ovalWidth('band-1987')} to{' '}
            {ovalWidth('band-current')} wide. The year of the middle ring is not in the artwork; it
            stays <span>[YEAR]</span> until it is supplied.
          </dd>
        </div>
      </dl>
    </div>

    <!-- Minimum size -->
    <div class="group review" id="rv-min">
      <h3>Minimum-size behaviour</h3>
      <p class="note">
        The wordmark at 240, 200, 160 and 120 px wide, as rendered. Below 200 px the sub-line is
        smaller than 4 px and stops being legible, so the rule is: wordmark from 200 px up, the
        monogram below that.
      </p>
      <div class="brand-stage" data-surface="dark">
        <ul class="min-sizes">
          {minWidths.map((w) => (
            <li>
              <BrandMark
                mark="wordmark"
                label="Casa Velado, established 1987, Estelí"
                class={`wm-${w}`}
              />
              <span>
                {w} px · name cap {((wm.nameCap / wmVB.w) * w).toFixed(1)} px · sub-line cap{' '}
                {((wm.subCap / wmVB.w) * w).toFixed(1)} px
              </span>
            </li>
          ))}
        </ul>
        <ul class="min-sizes min-sizes--mono">
          <li>
            <BrandMark mark="monogram" label="Casa Velado monogram" class="m-48" />
            <span>Monogram, 48 px</span>
          </li>
          <li>
            <BrandMark mark="monogram" label="Casa Velado monogram" class="m-32" />
            <span>Monogram, 32 px</span>
          </li>
        </ul>
      </div>
      <p class="note">
        Clear space is one cap height of the name ({wm.nameCap} units) on every side; at 200 px wide
        that is about
        {((wm.nameCap / wmVB.w) * 200).toFixed(0)} px.
      </p>
    </div>

    <!-- 7-9 Favicon -->
    <div class="group review" id="rv-favicon">
      <h3>7–9 · Favicon, ICO and touch icon</h3>
      <p class="note">
        Shown at their real pixel sizes. A 1× screen draws one image pixel per CSS pixel; on a 2×
        screen the browser picks a larger image or scales. The ICO entries are read from the shipped
        file and shown again magnified 6× with nearest-neighbour scaling, so single pixels can be
        inspected.
      </p>

      <div class="fav-block">
        <h4>
          7 · favicon.svg · viewBox {fvVB.w} × {fvVB.h}
        </h4>
        <ul class="fav-row">
          {[16, 32, 48].map((s) => (
            <li>
              <img src="/favicon.svg" width={s} height={s} alt="" />
              <span>{s} px</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fav-block">
        <h4>8 · favicon.ico · three embedded PNGs</h4>
        <ul class="fav-row">
          {icoEntries.map((e) => (
            <li>
              <img src={e.uri} width={e.size} height={e.size} alt="" />
              <span>
                {e.size} px, {e.bytes} B
              </span>
            </li>
          ))}
        </ul>
        <ul class="fav-row fav-row--loupe">
          {icoEntries.map((e) => (
            <li>
              <img class="loupe" src={e.uri} width={e.size * 6} height={e.size * 6} alt="" />
              <span>{e.size} px at 6×</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fav-block">
        <h4>9 · apple-touch-icon.png · 180 × 180</h4>
        <ul class="fav-row">
          <li>
            <img src="/apple-touch-icon.png" width="180" height="180" alt="" />
            <span>180 px</span>
          </li>
        </ul>
      </div>

      <dl class="rationale">
        <div>
          <dt>Favicon simplification</dt>
          <dd>
            The monogram's lines are too fine for a tab: its outer line is{' '}
            {pct1(mo.outer.stroke / moVB.w)} of the width, which at 16 px is
            {((mo.outer.stroke / moVB.w) * 16).toFixed(2)} px. The favicon drops the inner line and
            draws one line of {fv.oval.stroke} in 64, {pct1(fv.oval.stroke / fvVB.w)} of the width
            and {((fv.oval.stroke / fvVB.w) * 16).toFixed(2)} px at 16 px. The oval takes{' '}
            {pct((fv.oval.rx * 2) / fvVB.w)} of the tile, and the letters change from weight 400 to
            700 at a cap height of
            {fv.letters.cap}, {pct(fv.letters.cap / fvVB.h)} of the tile. The 16 px entry of the ICO
            keeps only the letters, at a cap height of {fv.tiny.cap} ({pct(fv.tiny.cap / fvVB.h)} of
            the tile), because a ring and two letters cannot both be read in 16 px. The touch icon
            is the larger, quieter version: both oval lines are kept ({ti.ovals[0]![2]} and{' '}
            {ti.ovals[1]![2]} in {tiVB.w}) and the letters are weight 600. Colours are gold{' '}
            <span>#B08D57</span> on warm black <span>#14110F</span>, opaque.
          </dd>
        </div>
        <div>
          <dt>For the designer to judge</dt>
          <dd>
            In the 16 px entry the letters span {fv.tiny.width} of the tile's 64, so they touch both
            edges. This was chosen for legibility at 16 px and is the first thing to check on the
            loupe above.
          </dd>
        </div>
      </dl>
    </div>
  </Section>

