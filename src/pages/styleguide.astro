  @media (min-width: 1024px) {
    .demos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
  }
</style>

<script>
  // Live readouts for review: viewport width, breakpoint, current type sizes, section space,
  // and the motion sample buttons. Nothing here is needed to read the page.
  const names = ['mobile', 'tablet', 'laptop', 'desktop', 'wide'] as const;

  function breakpoint(width: number): (typeof names)[number] {
    if (width < 640) return 'mobile';
    if (width < 1024) return 'tablet';
    if (width < 1280) return 'laptop';
    if (width < 1600) return 'desktop';
    return 'wide';
  }

  function update(): void {
    const width = window.innerWidth;
    const key = breakpoint(width);

    const viewport = document.querySelector('[data-viewport]');
    if (viewport) viewport.textContent = `${width} px`;
    const bp = document.querySelector('[data-breakpoint]');
    if (bp) bp.textContent = key.charAt(0).toUpperCase() + key.slice(1);

    document.querySelectorAll<HTMLElement>('[data-bp]').forEach((row) => {
      row.toggleAttribute('data-current', row.dataset['bp'] === key);
    });

    document.querySelectorAll<HTMLElement>('[data-role]').forEach((sample) => {
      const out = document.querySelector(`[data-live="${sample.dataset['role']}"]`);
      if (out) out.textContent = `${parseFloat(getComputedStyle(sample).fontSize).toFixed(1)} px`;
    });

    const probe = document.querySelector<HTMLElement>('[data-measure]');
    const probeOut = document.querySelector('[data-measure-out]');
    if (probe && probeOut)
      probeOut.textContent = `${Math.round(probe.getBoundingClientRect().height)} px`;
  }

  let frame = 0;
  window.addEventListener(
    'resize',
    () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    },
    { passive: true },
  );
  update();

  document.querySelectorAll<HTMLButtonElement>('[data-demo]').forEach((button) => {
    button.addEventListener('click', () => {
      const demo = button.closest<HTMLElement>('.demo');
      if (!demo) return;
      const on = !demo.hasAttribute('data-on');
      demo.toggleAttribute('data-on', on);
      button.setAttribute('aria-pressed', String(on));
    });
  });
</script>
