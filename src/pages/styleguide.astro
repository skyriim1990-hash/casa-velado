  <!-- Motion -->
  <Section id="motion" label="08 · Motion" title="Motion explains. It never performs.">
    <div class="group">
      <h3>Tokens</h3>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col" class="num">
              Value
            </th>
            <th scope="col">Used for</th>
          </tr>
        </thead>
        <tbody>
          {Object.entries(motion).map(([name, value]) => (
            <tr>
              <td data-label="Token">
                <code>--{name}</code>
              </td>
              <td data-label="Value" class="num-left">
                {value}
              </td>
              <td data-label="Used for">{durationUse[name] ?? ''}</td>
            </tr>
          ))}
          {Object.entries(easing).map(([name, value]) => (
            <tr>
              <td data-label="Token">
                <code>--{name}</code>
              </td>
              <td data-label="Value" class="num-left">
                {value}
              </td>
              <td data-label="Used for">
                {name === 'ease-out' ? 'Entrances and most transitions' : 'Cross-fades'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        Only <code>opacity</code> and <code>transform</code> animate. Page changes use native view
        transitions, a 200 ms cross-fade; there is no client-side router.
      </p>
    </div>

    <div class="group">
      <h3>Samples</h3>
      <p class="note">
        Press each button. With <code>prefers-reduced-motion: reduce</code> the movement is removed
        and only a 100 ms fade remains.
      </p>
      <div class="demos">
        <div class="demo">
          <button type="button" data-demo="fade" aria-pressed="false">
            Fade · image, 200 ms
          </button>
          <div class="stage">
            <span class="mover mover--fade" aria-hidden="true"></span>
          </div>
        </div>
        <div class="demo">
          <button type="button" data-demo="rise" aria-pressed="false">
            Rise · hero text, 450 ms
          </button>
