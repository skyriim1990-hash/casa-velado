---
// The journal (blueprint 2.3): depth and a reason to come back. A title, the categories as
// plain text, one leading entry and the rest. An index, not a feed: no hero, no “read more”, no
// authors, no counters, no search.
//
// The page is static HTML. All six entries are in it, and the categories are ordinary links
// (/journal?category=craft). With JavaScript (src/scripts/journal.ts) a category hides the
// entries of the others, writes itself to the URL and says how many are shown; without it the
// links lead to the same full list and nothing is hidden. On a phone the small entries are compact
// rows, from 640px two columns, from 1024px the large entry takes columns 1–7 beside two small
// ones, and the rest follow in rows of three.
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Container from '../components/Container.astro';
import { microcopy } from '../data/site.ts';
import { JOURNAL_CATEGORIES } from '../data/taxonomy.ts';
import { getArticles } from '../lib/catalogue.ts';

const c = microcopy.journal;
const articles = await getArticles();
const [lead, ...rest] = articles;
const slug = (category: string) => category.toLowerCase();
const copy = JSON.stringify({ shown: c.shown, shownOne: c.shownOne });
---

<Base title={c.title} description={c.description}>
  <div data-journal data-copy={copy}>
    <header class="head">
      <Container>
        <h1>{c.title}</h1>
      </Container>
    </header>

    <nav class="categories" aria-label={c.categories}>
      <Container>
        <ul>
          <li>
            <a href="/journal" data-category="all" aria-current="true">
              {c.all}
            </a>
          </li>
          {JOURNAL_CATEGORIES.map((category) => (
            <li>
              <a href={`/journal?category=${slug(category)}`} data-category={slug(category)}>
                {category}
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </nav>

    <section class="entries" aria-label={c.title}>
      <Container grid>
        <ul class="list" data-list>
          {lead && (
            <li data-entry data-category={slug(lead.data.category)}>
              <ArticleCard
                id={lead.id}
                article={lead.data}
                variant="large"
                ratio="4:3"
                headingLevel={2}
              />
            </li>
          )}
          {rest.map((entry) => (
            <li data-entry data-category={slug(entry.data.category)}>
              <ArticleCard id={entry.id} article={entry.data} variant="small" headingLevel={2} />
            </li>
          ))}
        </ul>
      </Container>
    </section>
  </div>
</Base>

<script>
  import '../scripts/journal.ts';
</script>

<style>
  .head {
    padding-block: var(--space-48) var(--space-16);
  }

  /* The categories: words, a 48px target each, the chosen one underlined and marked. */
  .categories ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-24);
    padding: 0;
    list-style: none;
    border-block-end: var(--line) solid var(--rule);
  }

  .categories a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target);
    text-decoration-color: transparent;
  }

  .categories a[aria-current='true'] {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  @media (hover: hover) and (pointer: fine) {
    .categories a:hover {
      text-decoration-color: currentColor;
    }
  }

  .entries {
    padding-block: var(--space-32) var(--space-section);
  }

  .list {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-32) var(--gutter);
    padding: 0;
    list-style: none;
  }

  /* [hidden] must hide a list item whatever its display is. */
  .list > li[hidden] {
    display: none;
  }

  /* A phone: every entry after the first is a row, the picture at 35% and the title beside it. */
  @media (max-width: 639px) {
    .list > li:not(:first-child) :global(.card.card) {
      grid-template-columns: 35% minmax(0, 1fr);
      align-items: start;
      gap: var(--space-16);
    }

    .list > li:not(:first-child) :global(.card.card .placeholder) {
      display: none;
    }

    .list > li:not(:first-child) :global(.card.card .title) {
      font-size: var(--fs-h4);
      line-height: var(--lh-h4);
    }
  }

  @media (min-width: 40rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-48);
    }

    .list > li:first-child {
      grid-column: 1 / -1;
    }
  }

  /* From 1024px: the large entry in columns 1–7, two small ones beside it in 9–12, the rest in rows of three. */
  @media (min-width: 64rem) {
    .list {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }

    .list > li:first-child {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }

    .list > li:nth-child(2),
    .list > li:nth-child(3) {
      grid-column: 9 / -1;
    }

    .list > li:nth-child(2) {
      grid-row: 1;
    }

    .list > li:nth-child(3) {
      grid-row: 2;
      align-self: end;
    }

    .list > li:nth-child(n + 4) {
      grid-column: span 4;
    }

    /* With a category chosen the entries that are left fall in rows of three. */
    .list[data-filtered] > li:nth-child(n) {
      grid-column: span 4;
      grid-row: auto;
      align-self: start;
    }
  }
</style>
